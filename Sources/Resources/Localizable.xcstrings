            "value": "Kalender und Mehr bleiben immer außen fixiert. Dazwischen kannst du bis zu 3 Bereiche platzieren und sortieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar and More always stay pinned on the edges. You can place up to 3 sections between them and drag to reorder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario y Más permanecen fijas en los extremos. Puedes añadir hasta 3 secciones entre ellas y reordenarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendrier et Plus restent toujours aux extrémités. Vous pouvez placer jusqu'à 3 sections entre eux et les réorganiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario e Altro restano fissi ai lati. Puoi inserire fino a 3 sezioni tra loro e riordinarle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendário e Mais permanecem fixos nas extremidades. Você pode colocar até 3 seções entre eles e reordenar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки «Календарь» и «Ещё» всегда закреплены по краям. Между ними можно добавить до 3 разделов и менять их порядок."
          }
        }
      }
    },
