    "backup.restore_confirm_message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aktuellen Daten in der App werden durch den Inhalt der ausgewählten Sicherungsdatei ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All current data in the app will be replaced with the contents of the selected backup file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los datos actuales de la app serán reemplazados por los del archivo seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données actuelles de l'application seront remplacées par le contenu du fichier sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i dati attuali nell'app verranno sostituiti dal contenuto del file selezionato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados atuais do app serão substituídos pelo conteúdo do arquivo selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все текущие данные в приложении будут заменены содержимым выбранного файла резервной копии."
          }
        }
      }
    },
