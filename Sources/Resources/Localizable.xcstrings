    "audio.delete_message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sprachaufnahme wird dauerhaft gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio recording will be permanently deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación de audio se eliminará permanentemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement vocal sera définitivement supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione vocale verrà eliminata definitivamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação de áudio será excluída permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудиозапись будет удалена без возможности восстановления."
          }
        }
      }
    },
