    "audio.permission_denied": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonzugriff verweigert. Aktiviere ihn in den iOS-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access denied. Enable it in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso al micrófono denegado. Actívalo en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au microphone refusé. Activez-le dans Réglages iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al microfono negato. Abilitalo in Impostazioni iOS."
