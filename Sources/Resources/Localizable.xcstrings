    "backup.json_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine vollständige Sicherung aller Termine, Vorlagen, Aufgaben, Tracker, Geburtstage, Kunden und Orte als JSON-Datei über Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a complete backup of all events, templates, tasks, trackers, birthdays, clients, and map markers as a JSON file via Files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia completa de eventos, plantillas, tareas, rastreadores, cumpleaños, clientes y marcadores en un archivo JSON mediante Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une sauvegarde complète de vos événements, modèles, tâches, suivis, anniversaires, clients et lieux en fichier JSON via Fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un backup completo di eventi, modelli, attività, tracker, compleanni, clienti e luoghi in un file JSON tramite File."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um backup completo de eventos, modelos, tarefas, rastreadores, aniversários, clientes e locais em um arquivo JSON via Arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните полную резервную копию всех событий, шаблонов, задач, трекеров, дней рождения, клиентов и точек в файл JSON через приложение «Файлы»."
          }
        }
      }
    },
